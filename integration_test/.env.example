# Revolt login credentials (required for auto-login integration tests)
# Get your session token from Revolt dev tools or cookie storage
REVOLT_TOKEN=your_session_token_here
REVOLT_API_BASE=https://api.revolt.chat
REVOLT_WS_URL=wss://ws.revolt.chat

# Voice channel to join during test (optional)
# Leave empty to skip voice join test
VOICE_SERVER_ID=
VOICE_CHANNEL_ID=
